// ✅ /start العادي
$bot->onCommand('start', function (Nutgram $bot) {
    app(\App\Telegram\Commands\StartCommand::class)->handle($bot);
});

// ✅ /start مع ref_XXX
$bot->onText('/start\s+ref_([A-Za-z0-9]+)', function (Nutgram $bot, string $code) {
    Cache::put(
        'referral_code_' . $bot->userId(),
        $code,
        now()->addMinutes(30),
    );

    Log::info('Referral code captured (onText)', [
        'telegram_id'   => $bot->userId(),
        'referral_code' => $code,
    ]);

    // ✅ تمرير $code كـ referralCode
    app(\App\Telegram\Commands\StartCommand::class)->handle($bot, $code);
});

