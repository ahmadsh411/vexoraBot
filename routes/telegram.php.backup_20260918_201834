// ============================================================
//  🎡 Wheel Admin — Text Input Handler (محسّن)
// ============================================================
// ⚠️ يجب أن يكون قبل fallback — يعالج الرسائل النصية للأدمن
// ⚠️ يفحص Cache محدد — لا يتعارض مع Conversations الأخرى

$bot->onMessage(function (Nutgram $bot) {
    $userId = $bot->userId();
    $text = trim($bot->message()?->text ?? '');

    // ✅ تجاهل الرسائل الفارغة والأوامر
    if ($text === '' || str_starts_with($text, '/')) {
        return;
    }

    // ✅ فحص سريع: هل توجد أي Cache key للـ Wheel Admin لهذا الأدمن؟
    // إذا لا، لا نستعلم DB أصلاً
    $keys = [
        "wheel_admin_edit_{$userId}",
        "wheel_admin_new_prize_{$userId}",
        "wheel_admin_edit_prize_{$userId}",
        "wheel_admin_edit_percent_{$userId}",
        "wheel_admin_user_search_{$userId}",
    ];

    $hasAnyState = false;
    foreach ($keys as $key) {
        if (\Illuminate\Support\Facades\Cache::has($key)) {
            $hasAnyState = true;
            break;
        }
    }

    if (! $hasAnyState) {
        // لا توجد حالة Wheel Admin — اترك الرسالة للـ Conversation إن وجد
        return;
    }

    // ✅ الآن نستعلم DB — فقط إذا كان هناك حالة
    $admin = \App\Models\User::where('telegram_id', $userId)->first();

    if (! $admin || ! $admin->is_admin) {
        return;
    }

    $service = app(\App\Services\WheelAdminService::class);

    // ==========================================================
    // 1) تعديل إعداد
    // ==========================================================
    if ($key = \Illuminate\Support\Facades\Cache::pull("wheel_admin_edit_{$userId}")) {
        $wheel = \App\Models\Wheel::first();

        if (! $wheel) {
            $bot->sendMessage(text: '❌ لا توجد عجلة.');
            return;
        }

        if (! is_numeric($text)) {
            $bot->sendMessage(text: '❌ القيمة يجب أن تكون رقماً.');
            return;
        }

        $value = (float) $text;

        try {
            $service->updateSettings($wheel, [$key => $value], $admin);
            $wheel->refresh();

            $bot->sendMessage(
                text: "✅ تم تحديث <b>{$key}</b> إلى <b>{$value}</b>",
                parse_mode: 'HTML',
            );
        } catch (\Throwable $e) {
            \Illuminate\Support\Facades\Log::error('Wheel setting update failed', [
                'key'   => $key,
                'value' => $value,
                'error' => $e->getMessage(),
            ]);

            $bot->sendMessage(text: "❌ {$e->getMessage()}");
        }
        return;
    }

    // ==========================================================
    // 2) إنشاء جائزة
    // ==========================================================
    if (\Illuminate\Support\Facades\Cache::pull("wheel_admin_new_prize_{$userId}")) {
        $parts = array_map('trim', explode('|', $text));

        if (count($parts) < 5) {
            $bot->sendMessage(
                text: "❌ الصيغة: <code>الاسم|الأيقونة|القيمة|العملة|النسبة|النوع</code>\n\n"
                    . "الأنواع: balance / empty / recycle",
                parse_mode: 'HTML',
            );
            return;
        }

        $name     = $parts[0];
        $icon     = $parts[1] ?: '🎁';
        $value    = (float) $parts[2];
        $currency = strtoupper($parts[3]);
        $weight   = (int) preg_replace('/[^0-9]/', '', $parts[4]);
        $type     = isset($parts[5]) ? strtolower(trim($parts[5])) : 'balance';

        if (! in_array($type, ['balance', 'empty', 'recycle'], true)) {
            $bot->sendMessage(text: '❌ النوع: balance / empty / recycle');
            return;
        }

        if ($type === 'recycle' || $type === 'empty') {
            $value = 0;
        }

        $wheel = \App\Models\Wheel::first();

        if (! $wheel) {
            $bot->sendMessage(text: '❌ لا توجد عجلة.');
            return;
        }

        try {
            $service->createPrize($wheel, [
                'name'     => $name,
                'icon'     => $icon,
                'value'    => $value,
                'currency' => $currency,
                'weight'   => $weight,
                'type'     => $type,
            ], $admin);

            $total = (int) $wheel->prizes()->sum('weight');

            $bot->sendMessage(
                text: "✅ تمت إضافة: <b>{$name}</b>\n"
                    . "🎯 النسبة: <b>{$weight}%</b>\n"
                    . "📊 المجموع: <b>{$total}%</b>",
                parse_mode: 'HTML',
            );
        } catch (\Throwable $e) {
            $bot->sendMessage(text: "❌ {$e->getMessage()}");
        }
        return;
    }

    // ==========================================================
    // 3) تعديل جائزة
    // ==========================================================
    if ($prizeId = \Illuminate\Support\Facades\Cache::pull("wheel_admin_edit_prize_{$userId}")) {
        $prize = \App\Models\WheelPrize::find($prizeId);

        if (! $prize) {
            $bot->sendMessage(text: '❌ الجائزة غير موجودة.');
            return;
        }

        $parts = array_map('trim', explode('|', $text));

        if (count($parts) < 5) {
            $bot->sendMessage(text: '❌ الصيغة غير صحيحة.');
            return;
        }

        [$name, $icon, $value, $currency, $weight] = $parts;

        try {
            $service->updatePrize($prize, [
                'name'     => $name,
                'icon'     => $icon ?: '🎁',
                'value'    => (float) $value,
                'currency' => strtoupper($currency),
                'weight'   => (int) $weight,
            ], $admin);

            $bot->sendMessage(
                text: "✅ تم التحديث: <b>{$name}</b>",
                parse_mode: 'HTML',
            );
        } catch (\Throwable $e) {
            $bot->sendMessage(text: "❌ {$e->getMessage()}");
        }
        return;
    }

    // ==========================================================
    // 3.b) تعديل النسبة
    // ==========================================================
    if ($prizeId = \Illuminate\Support\Facades\Cache::pull("wheel_admin_edit_percent_{$userId}")) {
        $prize = \App\Models\WheelPrize::find($prizeId);

        if (! $prize) {
            $bot->sendMessage(text: '❌ الجائزة غير موجودة.');
            return;
        }

        $clean = preg_replace('/[^0-9.]/', '', $text);

        if ($clean === '' || ! is_numeric($clean)) {
            $bot->sendMessage(text: "❌ أرسل رقماً 0-100.");
            return;
        }

        $percent = (float) $clean;

        if ($percent < 0 || $percent > 100) {
            $bot->sendMessage(text: '❌ النسبة بين 0 و 100.');
            return;
        }

        try {
            $service->updatePrizeWeight($prize, $percent, $admin);

            $total = (int) \App\Models\WheelPrize::where('wheel_id', $prize->wheel_id)->sum('weight');

            $warning = $total !== 100
                ? "\n\n⚠️ <b>تنبيه:</b> المجموع الآن <b>{$total}%</b>"
                : '';

            $bot->sendMessage(
                text: "✅ تم تحديث نسبة <b>{$prize->name}</b>\n"
                    . "النسبة: <b>{$percent}%</b>\n"
                    . "المجموع: <b>{$total}%</b>"
                    . $warning,
                parse_mode: 'HTML',
            );
        } catch (\Throwable $e) {
            $bot->sendMessage(text: "❌ {$e->getMessage()}");
        }
        return;
    }

    // ==========================================================
    // 4) بحث عن مستخدم
    // ==========================================================
    if (\Illuminate\Support\Facades\Cache::pull("wheel_admin_user_search_{$userId}")) {
        $user = \App\Models\User::where('username', 'like', "%{$text}%")
            ->orWhere('telegram_id', $text)
            ->orWhere('id', $text)
            ->first();

        if (! $user) {
            $bot->sendMessage(text: '❌ لا يوجد مستخدم.');
            return;
        }

        $state = \App\Models\WheelUserState::where('user_id', $user->id)->first();
        $spins = $state->available_spins ?? 0;
        $today = $state->spins_today ?? 0;

        $keyboard = \SergiX44\Nutgram\Telegram\Types\Keyboard\InlineKeyboardMarkup::make()
            ->addRow(
                \SergiX44\Nutgram\Telegram\Types\Keyboard\InlineKeyboardButton::make(
                    text: '➕ منح لفة',
                    callback_data: "wheel.admin.user.grant.{$user->id}",
                ),
                \SergiX44\Nutgram\Telegram\Types\Keyboard\InlineKeyboardButton::make(
                    text: '♻️ تصفير',
                    callback_data: "wheel.admin.user.reset.{$user->id}",
                ),
            )
            ->addRow(
                \SergiX44\Nutgram\Telegram\Types\Keyboard\InlineKeyboardButton::make(
                    text: '🔙 رجوع',
                    callback_data: 'wheel.admin',
                ),
            );

        $bot->sendMessage(
            text: "👤 <b>{$user->username}</b>\n\n"
                . "🎟 لفات: <b>{$spins}</b>\n"
                . "📅 اليوم: <b>{$today}</b>",
            parse_mode: 'HTML',
            reply_markup: $keyboard,
        );
        return;
    }
});

// ============================================================
//  🎯 Fallback
// ============================================================
$bot->fallback(function (Nutgram $bot) {
    if ($bot->isCallbackQuery()) {
        $data = $bot->callbackQuery()?->data;

        try {
            $bot->answerCallbackQuery(
                text: '❌ إجراء غير معروف',
                show_alert: false,
            );
        } catch (\Throwable $e) {
        }
        return;
    }

    $bot->sendMessage(
        text: "❓ <b>لم أفهم طلبك</b>\n\nاستخدم /start للبدء.",
        parse_mode: 'HTML',
    );
});
